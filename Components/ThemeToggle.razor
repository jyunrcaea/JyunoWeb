@inject IJSRuntime JS

<button class="icon-btn theme-toggle" @onclick="Toggle" aria-label="@(theme == "light" ? "다크 테마로 바꾸기" : "라이트 테마로 바꾸기")" title="@(theme == "light" ? "다크 테마로 바꾸기" : "라이트 테마로 바꾸기")">
    @if (theme == "light")
    {
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    }
</button>

@code {
    string theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        theme = await JS.InvokeAsync<string>("jyunoTheme.get");
        StateHasChanged();
    }

    async Task Toggle() => theme = await JS.InvokeAsync<string>("jyunoTheme.toggle");
}
