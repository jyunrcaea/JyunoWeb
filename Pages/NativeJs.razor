    sealed class Lane
    {
        public required string Name { get; init; }
        public bool Native { get; init; }
        public double? Ms { get; set; }
        public bool Running { get; set; }
        public string Detail { get; set; } = "";
        public string? Value { get; set; }
    }
    readonly Lane interpLane = new() { Name = "C# 인터프리터 (WASM)", Detail = "Jyuno 1.4.0 인터프리터를 워커의 .NET 런타임에서 실행" };
    readonly Lane nativeLane = new() { Name = "Native JS", Native = true, Detail = "JyunoSdk.NativeJs로 변환해서 워커의 JS 엔진으로 실행" };
    bool raceRunning;
    string raceStatus = "‘경주 시작’을 누르면 실행용 워커를 준비하고 두 엔진을 차례로 실행해요.";
    string? raceError;
    double? raceRatio;
    bool raceSameValue;
    IJSObjectReference? raceModule;

    record RunResult(string Status, string? Value, string? Message, double ElapsedMs, double CompileMs);

    void SelectRace(RaceProgram program)
    {
        raceProgram = program;
        ResetLanes();
    }

    void ResetLanes()
    {
        foreach (var lane in new[] { interpLane, nativeLane })
        {
            lane.Ms = null;
            lane.Value = null;
            lane.Running = false;
        }
        interpLane.Detail = "Jyuno 1.4.0 인터프리터를 워커의 .NET 런타임에서 실행";
        nativeLane.Detail = "JyunoSdk.NativeJs로 변환해서 워커의 JS 엔진으로 실행";
        raceRatio = null;
        raceError = null;
    }

    async Task Race()
    {
        if (raceRunning)
            return;
        ResetLanes();
        raceRunning = true;
        try
        {
            raceModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/native-race.js");
            raceStatus = "실행용 워커의 .NET 런타임을 준비하는 중…";
            StateHasChanged();
            int bootMs = await raceModule.InvokeAsync<int>("prepare");
            raceStatus = bootMs > 0 ? $"워커 준비 완료 ({bootMs} ms). 실행하는 중…" : "실행하는 중…";

            foreach (var lane in new[] { interpLane, nativeLane })
            {
                lane.Running = true;
                StateHasChanged();
                RunResult? measured = null;
                for (int i = 0; i < 3; i++)
                {
                    string json = await raceModule.InvokeAsync<string>("runOnce", TimeSpan.FromMinutes(2), raceProgram.Code, lane.Native);
                    var run = System.Text.Json.JsonSerializer.Deserialize<RunResult>(json, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
                    if (run is null || run.Status != "ok")
                    {
                        measured = run;
                        break;
                    }
                    if (measured is null || run.ElapsedMs + run.CompileMs < measured.ElapsedMs + measured.CompileMs)
                        measured = run;
                }
                lane.Running = false;
                if (measured is null || measured.Status != "ok")
                {
                    raceError = $"{lane.Name} 실행 실패: {measured?.Message ?? "알수 없는 오류"}";
                    return;
                }
                lane.Ms = measured.ElapsedMs + measured.CompileMs;
                lane.Value = measured.Value;
                lane.Detail = lane.Native
                    ? $"변환 {Ms(measured.CompileMs)} + 실행 {Ms(measured.ElapsedMs)} · 결과 {measured.Value}"
                    : $"실행 {Ms(measured.ElapsedMs)} · 결과 {measured.Value}";
                StateHasChanged();
            }
            raceSameValue = interpLane.Value == nativeLane.Value;
            raceRatio = interpLane.Ms / Math.Max(nativeLane.Ms ?? 0, 0.05);
        }
        catch (Exception e)
        {
            raceError = $"실행하지 못했어요: {e.Message}";
        }
        finally
        {
            raceRunning = false;
            interpLane.Running = nativeLane.Running = false;
            StateHasChanged();
        }
    }

    double LaneWidth(Lane lane)
    {
        double slowest = Math.Max(interpLane.Ms ?? 0, nativeLane.Ms ?? 0);
        if (lane.Ms is not { } ms || slowest <= 0)
            return 0;
        return Math.Max(ms / slowest * 100, 0.8);
    }

    static string LaneTime(Lane lane) => lane.Running ? "실행 중…" : lane.Ms is { } ms ? Ms(ms) : "—";

    void OpenInPlayground()
    {
        Playground.Open(FibJyuno, title: "Native JS 피보나치", nativeJs: true);
        Navigation.NavigateTo("playground");
    }

    public async ValueTask DisposeAsync()
    {
        if (raceModule is null)
            return;
        try
        {
            await raceModule.InvokeVoidAsync("dispose");
            await raceModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
