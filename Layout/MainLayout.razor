@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

<div class="page @(IsPlayground ? "page-playground" : "")">
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="" @onclick="CloseMenu">
                <Logo Size="30" />
                <span class="brand-name">Jyuno</span>
            </a>
            <nav class="site-nav @(menuOpen ? "open" : "")">
                <NavLink href="" Match="NavLinkMatch.All" @onclick="CloseMenu">소개</NavLink>
                <NavLink href="guide" @onclick="CloseMenu">문법 가이드</NavLink>
                <NavLink href="csharp" @onclick="CloseMenu">C#에서 쓰기</NavLink>
                <NavLink href="problems" @onclick="CloseMenu">문제 풀기</NavLink>
                <NavLink href="playground" class="nav-cta" @onclick="CloseMenu">
                    <span class="dot"></span> 플레이그라운드
                </NavLink>
            </nav>
            <div class="header-tools">
                <ThemeToggle />
                <a class="icon-btn" href="https://github.com/jyunrcaea/Jyuno" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
                    <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                </a>
                <button class="icon-btn menu-toggle" aria-label="메뉴" aria-expanded="@(menuOpen ? "true" : "false")" @onclick="() => menuOpen = !menuOpen">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="site-main">
        @Body
    </main>

    @if (!IsPlayground)
    {
        <footer class="site-footer">
            <div class="container footer-inner">
                <div class="footer-brand">
                    <Logo Size="22" />
                    <span>Jyuno · C# 앱을 위한 작고 안전한 스크립트 언어</span>
                </div>
                <div class="footer-links">
                    <a href="problems">문제 풀기</a>
                    <a href="https://github.com/jyunrcaea/Jyuno" target="_blank" rel="noopener">GitHub</a>
                    <a href="https://www.nuget.org/packages/Jyuno" target="_blank" rel="noopener">NuGet</a>
                    <a href="https://github.com/jyunrcaea/JyunoPrompt" target="_blank" rel="noopener">JyunoPrompt</a>
                    <a href="https://github.com/jyunrcaea/JyunoWeb" target="_blank" rel="noopener">이 사이트 소스</a>
                </div>
                <div class="footer-note">MIT License · 이 사이트는 Blazor WebAssembly로 만들어졌고, 플레이그라운드는 브라우저 안에서 진짜 Jyuno 인터프리터를 실행합니다.</div>
            </div>
        </footer>
    }
</div>

@code {
    bool menuOpen;

    bool IsPlayground => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/') == "playground";

    void CloseMenu() => menuOpen = false;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        menuOpen = false;
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
