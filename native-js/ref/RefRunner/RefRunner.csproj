<Project Sdk="Microsoft.NET.Sdk">
  <!-- Jyuno 1.3.2 인터프리터로 스크립트를 실행해서 기준 결과를 JSON으로 출력하는 도구 (차등 테스트/문제 테스트 추출용) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JyunoSource Condition="'$(JyunoSource)' == ''">../../../../Jyuno</JyunoSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(JyunoSource)/Jyuno.csproj" />
    <!-- JyunoWeb과 똑같은 콘솔/호스트 함수와 문제 정의를 그대로 사용 -->
    <Compile Include="../../../Engine/JyunoHost.cs" />
    <Compile Include="../../../Engine/Problem.cs" />
    <Compile Include="../../../Engine/Problems.cs" />
    <Compile Include="../../../Engine/Examples.cs" />
  </ItemGroup>
</Project>
